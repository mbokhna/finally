# PulseDesk configuration
#
# Every variable is optional — the defaults below are what the app uses if no
# .env file exists. A clean clone runs offline with no configuration at all.
#
# Copy to .env only if you want to change something:
#   cp .env.example .env

# Market data mode.
#   simulator  — built-in GBM price simulator. Offline, deterministic, free. (default)
#   live       — Binance WebSocket for crypto, Stooq CSV for GPW. Still free, no keys.
PULSEDESK_MARKET_MODE=simulator

# Base currency for the paper portfolio.
PULSEDESK_CURRENCY=PLN

# SQLite database file. In Docker this is a mounted volume.
PULSEDESK_DB_PATH=/data/pulsedesk.db

# Seconds between Stooq polls. GPW data is delayed at source, so polling faster
# than this gains nothing.
PULSEDESK_STOOQ_INTERVAL=60

# RNG seed for the simulator. Fixed value keeps tests deterministic.
PULSEDESK_SEED=42


# ─── AI assistant (optional) ──────────────────────────────────────────────────
#
# The only credential in this project, and it is optional. Without it the
# assistant panel reports itself as unconfigured and everything else works
# exactly as before.
#
# Get a key at https://openrouter.ai/keys

# OPENROUTER_API_KEY=sk-or-v1-...

# Model id. MUST end in ':free' — the backend refuses to start the assistant
# otherwise, so a paid model can never be selected by accident.
# Pick a current one from https://openrouter.ai/models filtered to free models;
# the free roster changes, so this is configuration, not a constant.
PULSEDESK_AI_MODEL=some-provider/some-model:free

# Response cap. Free tiers are rate-limited — keep replies short.
PULSEDESK_AI_MAX_TOKENS=800
