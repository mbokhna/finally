      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(docker system prune*)",
      "Bash(docker volume rm*)",
      "Edit(.env)",
      "Write(.env)",
      "Edit(**/.env)",
      "Write(**/.env)"
